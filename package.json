{
  "name": "susprev-sc",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --reload-dir app --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}