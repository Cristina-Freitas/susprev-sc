# URL do backend FastAPI do SUSPrev SC.
# O navegador não acessa esta URL diretamente: o servidor do Vite
# (npm run dev / npm run preview) encaminha as chamadas de /api para ela.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Prefixo usado pelo navegador para alcançar a API (normalmente não precisa mudar).
# Em uma implantação com proxy reverso próprio, aponte para o caminho publicado.
VITE_API_PREFIX=/api
